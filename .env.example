# --- OpenSearch connection ---
OPENSEARCH_URL=http://localhost:9200

# --- Index & pipeline names ---
INDEX_NAME=hybrid-sparse-index
INGEST_PIPELINE=hybrid-sparse-ingest
SEARCH_PIPELINE=hybrid-sparse-search

# --- Neural sparse INGEST model (doc-only mode) ---
# Ingest-time model that expands each document into token -> weight (sparse) features.
MODEL_NAME=amazon/neural-sparse/opensearch-neural-sparse-encoding-doc-v3-distill
MODEL_VERSION=1.0.0
MODEL_FORMAT=TORCH_SCRIPT
# Query-time analyzer (doc-only mode, OpenSearch 3.x): tokenizes the query WITHOUT
# model inference. No separate query-side model needed on 3.x.
QUERY_ANALYZER=bert-uncased

# Filled in automatically by scripts/bootstrap_opensearch.py after the model deploys.
MODEL_ID=

# --- Hybrid score combination weights: [lexical, sparse] ---
LEXICAL_WEIGHT=0.3
SPARSE_WEIGHT=0.7

# --- Dataset / seeding ---
# /documents/seed indexes SEED_DATA_FILE. The Flickr dataset is built from FLICKR_CSV
# by scripts/prepare_flickr.py (`make prepare`). FLICKR_SUBSET_SIZE = images to index.
SEED_DATA_FILE=data/flickr_docs.json
FLICKR_CSV=data/results.csv
FLICKR_SUBSET_SIZE=1000
FLICKR_IMAGES_DIR=data/images
