# --- OpenSearch connection ---
OPENSEARCH_URL=http://localhost:9200

# --- Index & pipeline names ---
INDEX_NAME=hybrid-sparse-index
INGEST_PIPELINE=hybrid-sparse-ingest
SEARCH_PIPELINE=hybrid-sparse-search

# --- Neural sparse INGEST model (doc-only mode) ---
# Ingest-time model that expands each document into token -> weight (sparse) features.
MODEL_NAME=amazon/neural-sparse/opensearch-neural-sparse-encoding-doc-v3-distill
MODEL_VERSION=1.0.0
MODEL_FORMAT=TORCH_SCRIPT
# Query-time analyzer (doc-only mode, OpenSearch 3.x): tokenizes the query WITHOUT
# model inference. No separate query-side model needed on 3.x.
QUERY_ANALYZER=bert-uncased

# Filled in automatically by scripts/bootstrap_opensearch.py after the model deploys.
MODEL_ID=

# --- Hybrid score combination weights: [lexical, sparse] ---
LEXICAL_WEIGHT=0.3
SPARSE_WEIGHT=0.7

# --- Dense semantic search (separate POC) ---
# Dense text-embedding model + knn_vector + `neural` query. Unlike sparse doc-only,
# this runs the model at QUERY time. DENSE_MODEL_ID is filled in by the dense bootstrap.
DENSE_INDEX_NAME=semantic-dense-index
DENSE_INGEST_PIPELINE=semantic-dense-ingest
DENSE_MODEL_NAME=huggingface/sentence-transformers/msmarco-distilbert-base-tas-b
DENSE_MODEL_VERSION=1.0.3
DENSE_MODEL_FORMAT=TORCH_SCRIPT
DENSE_MODEL_ID=
EMBEDDING_DIMENSION=768
DENSE_SPACE_TYPE=l2
DENSE_ENGINE=lucene
KNN_FIELD=combined_text_knn

# --- Multimodal search (CLIP, run in the app) ---
# CLIP embeds image pixels (and query text) into the same space, in OUR app. OpenSearch
# is only the kNN vector store here. Needs the `multimodal` extra installed.
MULTIMODAL_INDEX_NAME=multimodal-clip-index
CLIP_MODEL_NAME=clip-ViT-B-32
CLIP_DIMENSION=512
CLIP_SPACE_TYPE=cosinesimil
CLIP_ENGINE=lucene
IMAGE_VECTOR_FIELD=image_vector

# --- Dataset / seeding ---
# /documents/seed indexes SEED_DATA_FILE. The Flickr dataset is built from FLICKR_CSV
# by scripts/prepare_flickr.py (`make prepare`). FLICKR_SUBSET_SIZE = images to index.
SEED_DATA_FILE=data/flickr_docs.json
FLICKR_CSV=data/results.csv
FLICKR_SUBSET_SIZE=1000
FLICKR_IMAGES_DIR=data/images
