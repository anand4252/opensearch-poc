# --- OpenSearch connection ---
OPENSEARCH_URL=http://localhost:9200

# --- Index & pipeline names ---
INDEX_NAME=hybrid-sparse-index
INGEST_PIPELINE=hybrid-sparse-ingest
SEARCH_PIPELINE=hybrid-sparse-search

# --- Neural sparse INGEST model (doc-only mode) ---
# Ingest-time model that expands each document into token -> weight (sparse) features.
MODEL_NAME=amazon/neural-sparse/opensearch-neural-sparse-encoding-doc-v3-distill
MODEL_VERSION=1.0.0
MODEL_FORMAT=TORCH_SCRIPT

# --- Neural sparse QUERY tokenizer (doc-only mode) ---
# OpenSearch 2.19 doesn't support the `analyzer` field on neural_sparse queries, so
# doc-only search tokenizes the query via this lightweight model (no heavy inference).
QUERY_MODEL_NAME=amazon/neural-sparse/opensearch-neural-sparse-tokenizer-v1
QUERY_MODEL_VERSION=1.0.1

# Filled in automatically by scripts/bootstrap_opensearch.py after the models deploy.
MODEL_ID=
QUERY_MODEL_ID=

# --- Hybrid score combination weights: [lexical, sparse] ---
LEXICAL_WEIGHT=0.3
SPARSE_WEIGHT=0.7
